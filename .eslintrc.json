{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended",
    "next/core-web-vitals"
  ],
  "plugins": [
    "react",
    "@typescript-eslint",
    "react-hooks"
  ],
  "rules": {
    "react/prop-types": "off",  // Si usas TypeScript, no necesitas prop-types
    "react/react-in-jsx-scope": "off",  // No es necesario con React 17+
    "@typescript-eslint/explicit-module-boundary-types": "off",  // Desactiva la regla que requiere tipos explícitos en funciones
    "no-unused-vars": "warn",  // Previene variables no utilizadas
    "@typescript-eslint/no-unused-vars": "warn",  // Previene variables no utilizadas en TypeScript
    "react/jsx-uses-react": "off",  // No necesario con React 17+
    "react/jsx-uses-vars": "error"  // Marca las variables usadas en JSX como "usadas"
  },
  "settings": {
    "react": {
      "version": "detect"  // Detecta automáticamente la versión de React
    }
  }
}